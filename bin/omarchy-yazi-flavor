#!/usr/bin/env bash
# Generate a Yazi flavor from an Omarchy theme palette and (optionally) activate it.
#
# Usage:
#   omarchy-yazi-flavor            Re-generate + activate flavor of the current theme
#   omarchy-yazi-flavor <theme>    Same, for a specific theme ("Tokyo Night" or "tokyo-night")
#   omarchy-yazi-flavor --all      Generate flavors for every Omarchy theme (no activation)
#
# Flavors land in ~/.config/yazi/flavors/omarchy-<slug>.yazi/ and are kept in
# sync by the theme-set hook (~/.config/omarchy/hooks/theme-set.d/yazi.sh),
# so running Yazi instances re-skin instantly on `omarchy theme set ...`.
#
# Security model (see README): the current-theme state file and the theme
# list come from user-writable storage, so every read is bounded in bytes
# and wall-clock time, happens only from a regular non-symlink file, and
# every name is reduced to a single bounded path segment before it is ever
# interpolated into a directory or file path. Any anomaly fails closed.
set -euo pipefail

FLAVORS_DIR="$HOME/.config/yazi/flavors"
THEME_TOML="$HOME/.config/yazi/theme.toml"

STATE_FILE="${OMARCHY_YAZI_THEME_STATE:-$HOME/.local/state/omarchy/current/theme.name}"
NAME_MAX_LEN=64        # longest theme name/slug accepted, in bytes
READ_MAX_BYTES=256     # bytes ever read from the state file
READ_TIMEOUT=2         # seconds; hard deadline for the state-file read
LIST_TIMEOUT=5         # seconds; hard deadline for the all-theme enumeration
LIST_MAX_ITEMS=64      # themes processed per --all run
KILL_GRACE=1           # SIGKILL grace (seconds) after timeout(1)'s SIGTERM
PALETTE_MAX_BYTES=32768 # 32 KB cap for palette file reads
PALETTE_READ_TIMEOUT=2  # seconds; hard deadline for palette reads
ALACRITTY_TIMEOUT=5     # seconds; hard deadline for alacritty conversion
PREVIEW_MAX_BYTES=1048576 # 1 MB cap for preview.png copy

die() { echo "omarchy-yazi-flavor: $*" >&2; exit 1; }
warn() { echo "omarchy-yazi-flavor: warning: $*" >&2; }

slugify() { sed -E 's/<[^>]+>//g' <<<"$1" | tr '[:upper:]' '[:lower:]' | tr ' ' '-'; }

# One bounded, path-safe segment: no separators, no dot-leading names,
# length-capped. Anything failing this must never reach a filesystem path.
valid_slug() {
	local s=$1
	(( ${#s} <= NAME_MAX_LEN )) || return 1
	[[ $s =~ ^[a-z0-9][a-z0-9._-]*$ ]]
}

# Read the current theme safely. The state file lives in user-writable
# storage and could be swapped for a FIFO, symlink, device node, or plain
# garbage, so: require a regular non-symlink file, read at most
# READ_MAX_BYTES under a hard deadline, keep only a printable first line,
# and fail closed on any anomaly.
read_current_theme() { # -> name on stdout; rc!=0 on anomaly
	local f=$1 out
	[[ -f $f && ! -L $f ]] || return 1
	out=$(timeout --signal=TERM "--kill-after=${KILL_GRACE}s" "${READ_TIMEOUT}s" \
		dd if="$f" bs=1 count="$READ_MAX_BYTES" 2>/dev/null) || return 1
	out=${out%%$'\n'*}
	(( ${#out} > 0 && ${#out} <= NAME_MAX_LEN )) || return 1
	[[ $out =~ ^[[:print:]]+$ ]] || return 1
	printf '%s' "$out"
}

pal_try() { # pal_try <key> <colors.toml>; prints value or nothing, never fails
	local v
	v=$(head -c "$PALETTE_MAX_BYTES" "$2" 2>/dev/null \
		| timeout --signal=TERM "--kill-after=${KILL_GRACE}s" "${PALETTE_READ_TIMEOUT}s" \
		grep -m1 -E "^$1[[:space:]]*=" 2>/dev/null \
		| sed -E 's/^[^=]*=[[:space:]]*"([^"]*)".*/\1/') || true
	[[ -n $v ]] && printf '%s' "$v"
	return 0
}

# First non-empty of the listed keys in <file>: first_of file key [key...]
first_of() {
	local f=$1 k
	shift
	for k in "$@"; do
		local v
		v=$(pal_try "$k" "$f")
		[[ -n $v ]] && { printf '%s' "$v"; return 0; }
	done
	return 1
}

# Perceived luminance of a "#rrggbb" hex color, 0-255
lum() { awk -v h="${1#"#"}" 'BEGIN {
	r = strtonum("0x" substr(h, 1, 2))
	g = strtonum("0x" substr(h, 3, 2))
	b = strtonum("0x" substr(h, 5, 2))
	printf "%.0f", 0.2126 * r + 0.7152 * g + 0.0722 * b
}'; }

# Validate a palette value is a safe #rrggbb hex color.
valid_color() { [[ $1 =~ ^#[0-9a-f]{6}$ ]]; }

# Safe color extraction: returns the value only if it is valid hex,
# otherwise prints the fallback. Never fails.
safe_color() { # safe_color <value> <fallback>
	local v=$1 fb=$2
	if [[ $v =~ ^#[0-9a-f]{6}$ ]]; then
		printf '%s' "$v"
	else
		printf '%s' "$fb"
	fi
}

# Locate or synthesize a usable colors.toml for a theme slug.
resolve_palette() { # resolve_palette <slug> ; prints path to colors.toml
	local slug=$1 src p tmp
	src="$HOME/.config/omarchy/themes/$slug"
	[[ -d $src ]] || src="${OMARCHY_PATH:-/usr/share/omarchy}/themes/$slug"
	p="$src/colors.toml"

	if [[ ! -f $p && -f $src/alacritty.toml ]]; then
		[[ ! -L $src/alacritty.toml ]] || { warn "symlinked palette rejected: $src/alacritty.toml"; return 1; }
		tmp=$(mktemp -d)
		cp "$src/alacritty.toml" "$tmp/"
		if timeout --signal=TERM "--kill-after=${KILL_GRACE}s" "${ALACRITTY_TIMEOUT}s" \
			omarchy-theme-colors-from-alacritty "$tmp" >/dev/null 2>&1 &&
			[[ -f $tmp/colors.toml && ! -L $tmp/colors.toml ]]; then
			printf '%s\n' "$tmp/colors.toml"
			return 0
		fi
		rm -rf "$tmp"
	fi
	[[ -f $p && ! -L $p ]] && { printf '%s\n' "$p"; return 0; }
	[[ -L $p ]] && { warn "symlinked palette rejected: $p"; }
	return 1
}

write_atomic() { # write_atomic <target> ; content on stdin
	local tmp
	tmp=$(mktemp "${1%/*}/.$(basename "$1").XXXXXX")
	cat >"$tmp"
	chmod 644 "$tmp"
	mv -f "$tmp" "$1"
}

	build_flavor() {
	local theme=$1 dir p src
	valid_slug "$theme" || { warn "unsafe theme name '$theme', skipping"; return 1; }
	p=$(resolve_palette "$theme") || { warn "no usable palette for '$theme', skipping"; return 1; }
	src=$(dirname "$p")
	dir="$FLAVORS_DIR/omarchy-$theme.yazi"

	# Remove any symlink in the plugin's flavor namespace and recreate as a
	# real directory. A symlinked dir would redirect writes outside the
	# documented omarchy-* namespace.
	if [[ -L "$dir" ]]; then
		warn "removing symlinked flavor dir: $dir"
		rm -rf "$dir"
	fi

	# Normalize across palette schemas: rich omarchy themes carry semantic
	# keys; alacritty-derived / ANSI-scheme themes only have color0-15.
	local MODE BG DBG SURF SEL MUT DIM TXT BRIGHT \
		C0 C1 C2 C3 C4 C5 C6 C7 C9 \
		ACC RED YEL ORG GRN CYN MAG
	BG=$(first_of "$p" background) || { warn "'background' missing in $p, skipping"; return 1; }
	TXT=$(first_of "$p" foreground) || TXT=$BG
	BRIGHT=$(first_of "$p" bright_foreground) || BRIGHT=$TXT
	C1=$(pal_try color1 "$p"); C2=$(pal_try color2 "$p")
	C3=$(pal_try color3 "$p"); C4=$(pal_try color4 "$p")
	C5=$(pal_try color5 "$p"); C6=$(pal_try color6 "$p")
	C8=$(pal_try color8 "$p"); C9=$(pal_try color9 "$p")

	ACC=$(first_of "$p" accent blue) || ACC=${C4:-$BG}
	RED=$(first_of "$p" red) || RED=${C1:-$ACC}
	YEL=$(first_of "$p" yellow) || YEL=${C3:-$TXT}
	GRN=$(first_of "$p" green) || GRN=${C2:-$YEL}
	CYN=$(first_of "$p" cyan) || CYN=${C6:-${C4:-$ACC}}
	MAG=$(first_of "$p" magenta) || MAG=${C5:-${C1:-$RED}}
	ORG=$(first_of "$p" orange brown bright_red) || ORG=${C9:-$YEL}

	SURF=$(first_of "$p" lighter_background) || SURF=${C8:-$BG}
	SEL=$(first_of "$p" selection_background selection) || SEL=$SURF
	MUT=$(first_of "$p" muted) || MUT=$SEL
	DIM=$(first_of "$p" dark_foreground) || DIM=$MUT
	DBG=$(first_of "$p" darker_background dark_background) || DBG=$BG
	MODE=$(first_of "$p" mode) || { [[ $(lum "$BG") -gt 127 ]] && MODE=light || MODE=dark; }

	mkdir -p "$dir"
	[[ ! -L "$dir" ]] || { warn "flavor dir is a symlink after mkdir, skipping: $dir"; return 1; }

	# Validate all colors are safe #rrggbb before interpolating into the heredoc.
	# A malformed palette value must not break the TOML or execute shell code.
	BG=$(safe_color "$BG" "#000000")
	TXT=$(safe_color "$TXT" "$BG")
	BRIGHT=$(safe_color "$BRIGHT" "$TXT")
	C1=$(safe_color "${C1:-}" "#888888"); C2=$(safe_color "${C2:-}" "#888888")
	C3=$(safe_color "${C3:-}" "#888888"); C4=$(safe_color "${C4:-}" "#888888")
	C5=$(safe_color "${C5:-}" "#888888"); C6=$(safe_color "${C6:-}" "#888888")
	C8=$(safe_color "${C8:-}" "#888888"); C9=$(safe_color "${C9:-}" "#888888")
	ACC=$(safe_color "$ACC" "$C4"); RED=$(safe_color "$RED" "$C1")
	YEL=$(safe_color "$YEL" "$C3"); GRN=$(safe_color "$GRN" "$C2")
	CYN=$(safe_color "$CYN" "$C6"); MAG=$(safe_color "$MAG" "$C5")
	ORG=$(safe_color "$ORG" "$YEL")
	SURF=$(safe_color "$SURF" "$C8"); SEL=$(safe_color "$SEL" "$SURF")
	MUT=$(safe_color "$MUT" "$SEL"); DIM=$(safe_color "$DIM" "$MUT")
	DBG=$(safe_color "$DBG" "$BG")

	write_atomic "$dir/flavor.toml" <<EOF
# vim:fileencoding=utf-8:foldmethod=marker
# Generated from Omarchy theme "$theme" ($MODE palette) by omarchy-yazi-flavor.
# Do not edit; edit the theme's colors.toml or the generator instead.

# : Manager {{{

[mgr]
cwd = { fg = "$CYN", bold = true }

# Find
find_keyword  = { fg = "$YEL", bold = true, italic = true, underline = true }
find_position = { fg = "$MAG", bg = "reset", bold = true, italic = true }

# Marker
marker_copied   = { fg = "$GRN", bg = "$GRN" }
marker_cut      = { fg = "$RED", bg = "$RED" }
marker_marked   = { fg = "$CYN", bg = "$CYN" }
marker_selected = { fg = "$YEL", bg = "$YEL" }

# Count
count_copied   = { fg = "$DBG", bg = "$GRN" }
count_cut      = { fg = "$DBG", bg = "$RED" }
count_selected = { fg = "$DBG", bg = "$YEL" }

# Border
border_symbol = "│"
border_style  = { fg = "$MUT" }

# : }}}


# : Tabs {{{

[tabs]
active   = { fg = "$DBG", bg = "$ACC", bold = true }
inactive = { fg = "$ACC", bg = "$SURF" }

# : }}}


# : Mode {{{

[mode]

normal_main = { fg = "$DBG", bg = "$ACC", bold = true }
normal_alt  = { fg = "$ACC", bg = "$SURF" }

select_main = { fg = "$DBG", bg = "$CYN", bold = true }
select_alt  = { fg = "$CYN", bg = "$SURF" }

unset_main  = { fg = "$DBG", bg = "$ORG", bold = true }
unset_alt   = { fg = "$ORG", bg = "$SURF" }

# : }}}


# : Status bar {{{

[status]
perm_sep   = { fg = "$MUT" }
perm_type  = { fg = "$ACC" }
perm_read  = { fg = "$YEL" }
perm_write = { fg = "$RED" }
perm_exec  = { fg = "$GRN" }

progress_label  = { fg = "$BRIGHT", bold = true }
progress_normal = { fg = "$GRN", bg = "$SEL" }
progress_error  = { fg = "$YEL", bg = "$RED" }

# : }}}


# : Pick {{{

[pick]
border   = { fg = "$ACC" }
active   = { fg = "$MAG", bold = true }
inactive = {}

# : }}}


# : Input {{{

[input]
border   = { fg = "$ACC" }
title    = {}
value    = {}
selected = { reversed = true }

# : }}}


# : Completion {{{

[cmp]
border = { fg = "$ACC" }

# : }}}


# : Tasks {{{

[tasks]
border  = { fg = "$ACC" }
title   = {}
hovered = { fg = "$MAG", bold = true }

# : }}}


# : Which {{{

[which]
mask            = { bg = "$SURF" }
cand            = { fg = "$CYN" }
rest            = { fg = "$DIM" }
desc            = { fg = "$MAG" }
separator       = "  "
separator_style = { fg = "$MUT" }

# : }}}


# : Help {{{

[help]
on      = { fg = "$CYN" }
run     = { fg = "$MAG" }
hovered = { reversed = true, bold = true }
footer  = { fg = "$SURF", bg = "$TXT" }

# : }}}


# : Spotter {{{

[spot]
border   = { fg = "$ACC" }
title    = { fg = "$ACC" }
tbl_col  = { fg = "$CYN" }
tbl_cell = { fg = "$MAG", bg = "$SEL" }

# : }}}


# : Notification {{{

[notify]
title_info  = { fg = "$GRN" }
title_warn  = { fg = "$YEL" }
title_error = { fg = "$RED" }

# : }}}


# : File-specific styles {{{

[filetype]

rules = [
	# Image
	{ mime = "image/*", fg = "$CYN" },
	# Media
	{ mime = "{audio,video}/*", fg = "$YEL" },
	# Archive
	{ mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "$MAG" },
	# Document
	{ mime = "application/{pdf,doc,rtf}", fg = "$GRN" },
	# Virtual file system
	{ mime = "vfs/{absent,stale}", fg = "$DIM" },
	# Fallback
	{ url = "*", fg = "$TXT" },
	{ url = "*/", fg = "$ACC" },
]

# : }}}

[icon]

dirs = [
	{ name = ".config", text = "", fg = "$MAG" },
	{ name = ".git", text = "", fg = "$CYN" },
	{ name = ".github", text = "", fg = "$ACC" },
	{ name = "Desktop", text = "", fg = "$GRN" },
	{ name = "Documents", text = "", fg = "$GRN" },
	{ name = "Downloads", text = "", fg = "$GRN" },
	{ name = "Music", text = "", fg = "$GRN" },
	{ name = "Pictures", text = "", fg = "$GRN" },
	{ name = "Videos", text = "", fg = "$GRN" },
	{ name = "Public", text = "", fg = "$GRN" },
]
conds = [
	{ if = "orphan", text = "", fg = "$TXT" },
	{ if = "link", text = "", fg = "$MUT" },
	{ if = "dummy", text = "", fg = "$RED" },
	{ if = "dir & hovered", text = "", fg = "$ACC" },
	{ if = "dir", text = "", fg = "$ACC" },
	{ if = "exec", text = "", fg = "$MUT" },
	{ if = "!dir", text = "", fg = "$TXT" },
]

EOF

	write_atomic "$dir/README.md" <<EOF
# omarchy-$theme

Auto-generated Yazi flavor mirroring the Omarchy theme **$theme**.
Regenerated automatically whenever the theme is applied (see
~/.config/omarchy/hooks/theme-set.d/). Tweak colors in the theme's
colors.toml instead of editing this flavor.
EOF

	# Best-effort preview thumbnail from the theme itself (capped at 1 MB)
	if [[ -f $src/preview.png && ! -L $src/preview.png ]]; then
		local psize
		psize=$(stat --format=%s "$src/preview.png" 2>/dev/null) || psize=0
		if (( psize > 0 && psize <= PREVIEW_MAX_BYTES )); then
			cp -f "$src/preview.png" "$dir/preview.png" 2>/dev/null || true
		fi
	fi

	echo "generated: $dir/flavor.toml"
}

activate_flavor() {
	local theme=$1
	[[ -f $THEME_TOML || -f ${THEME_TOML}.pre-omarchy ]] || die "no theme.toml found"
	# Atomic backup: hard-link then rename to avoid TOCTOU races where two
	# concurrent syncs could overwrite each other's backup.
	if [[ ! -f ${THEME_TOML}.pre-omarchy ]]; then
		ln -f "$THEME_TOML" "${THEME_TOML}.pre-omarchy.tmp" 2>/dev/null \
			&& mv -f "${THEME_TOML}.pre-omarchy.tmp" "${THEME_TOML}.pre-omarchy" \
			|| cp "$THEME_TOML" "${THEME_TOML}.pre-omarchy"
	fi
	write_atomic "$THEME_TOML" <<EOF
#"\$schema" = "https://yazi-rs.github.io/schemas/theme.json"
# Managed by Omarchy (omarchy-yazi-flavor): regenerated on every theme change.
# Your pre-hook config is preserved at theme.toml.pre-omarchy; personal styling
# belongs in your own flavor under ~/.config/yazi/flavors/.

[flavor]
dark  = "omarchy-$theme"
light = "omarchy-$theme"
EOF
	echo "activated: omarchy-$theme -> $THEME_TOML"
}

main() {
	mkdir -p "$FLAVORS_DIR"

	case "${1:-}" in
	--all)
		local t n=0
		while IFS= read -r t; do
			t=$(slugify "$t")
			valid_slug "$t" || { warn "skipping untrustworthy theme name"; continue; }
			# guard against set -e: themes without palettes are expected skips
			build_flavor "$t" || true
			if (( ++n >= LIST_MAX_ITEMS )); then
				warn "theme list truncated at $LIST_MAX_ITEMS entries"
				break
			fi
		done < <(timeout --signal=TERM "--kill-after=${KILL_GRACE}s" \
			"${LIST_TIMEOUT}s" omarchy theme list 2>/dev/null || true)
		exit 0
		;;
	"")
		cur=$(read_current_theme "$STATE_FILE") ||
			die "could not safely read '$STATE_FILE' (missing, not a regular file, or timed out); refusing to guess"
		;;
	*)
		cur=$1
		;;
	esac

	cur=$(slugify "$cur")
	valid_slug "$cur" || die "refusing unsafe theme name '$cur'"
	build_flavor "$cur"
	activate_flavor "$cur"
}

main "$@"
